---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Akses Ditolak">
  <main class="flex min-h-screen items-center justify-center bg-slate-50 px-6">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center shadow-sm">
      <p class="font-heading text-7xl font-black text-[#1A2E4C]">403</p>
      <h1 class="mt-4 font-heading text-2xl font-extrabold text-[#1A2E4C]">Halaman Tidak Ditemukan?</h1>
      <p class="mt-2 text-sm leading-relaxed text-slate-500">
        Halaman yang Anda coba akses tidak tersedia atau Anda tidak memiliki izin untuk mengaksesnya. Silakan kembali ke beranda atau hubungi administrator jika Anda yakin ini adalah kesalahan.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center justify-center rounded-xl bg-[#1A2E4C] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#C26527]"
      >
        Kembali ke Beranda
      </a>
    </div>
  </main>
</Layout>